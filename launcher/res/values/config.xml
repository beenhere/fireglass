<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher settings. Edit, then run launcher/build-and-install.sh.
  Package names: tools/venv/bin/python -I tools/tv.py 'pm list packages'
-->
<resources>
    <!-- Dock apps, left to right. Apps that aren't installed are skipped. -->
    <string-array name="dock_apps">
        <item>com.netflix.ninja</item>
        <item>in.startv.hotstar</item>
        <item>com.amazon.firebat</item>
        <item>com.amazon.firetv.youtube</item>
        <item>com.jio.media.stb.ondemand</item>
        <item>com.apple.atve.amazon.appletv</item>
    </string-array>

    <!-- Never shown as tiles: Amazon helpers (Alexa audio home, troubleshooting, spiderpork). -->
    <string-array name="hidden_apps">
        <item>com.amazon.audiohome</item>
        <item>com.amazon.firetv.troubleshooting</item>
        <item>com.amazon.spiderpork</item>
    </string-array>

    <!-- Tiles per row in the grid. -->
    <integer name="columns">5</integer>
</resources>
